# Google OAuth (for Sign in with Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API
# - Desktop: http://localhost:8000/api
# - Mobile/tunnel: set NEXT_PUBLIC_API_URL_TUNNEL to your Mac's IP, e.g. http://10.7.11.19:8000/api
# - Production (Vercel + AWS): https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL_TUNNEL=

# Visitor IP tracking: skipped on localhost/127.0.0.1 unless NEXT_PUBLIC_ENABLE_VISITOR_TRACKING=true
# NEXT_PUBLIC_DISABLE_VISITOR_TRACKING=true  (disable on any host)
