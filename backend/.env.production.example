# Production env for AWS — copy to .env and set DJANGO_ENV=production

SECRET_KEY=generate-a-long-random-secret-key
DJANGO_ENV=production

# AWS RDS PostgreSQL
DB_NAME=direction
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=your-rds.xxxxxxxxxx.region.rds.amazonaws.com
DB_PORT=5432
DB_SSL=true

# Hosts — comma-separated (API domain, any custom domains)
ALLOWED_HOSTS=api.yourdomain.com,your-ec2-ip.compute.amazonaws.com

# CORS — frontend origins that can call the API (Vercel, custom domain)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# CSRF — same as ALLOWED_HOSTS but with https:// prefix
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your-secret
REPORT_PRICE_INR=299

# Google OAuth — add AWS API domain to Google Console authorized origins
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
