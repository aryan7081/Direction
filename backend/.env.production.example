# Production env for AWS — copy to .env and set DJANGO_ENV=production

SECRET_KEY=generate-a-long-random-secret-key
DJANGO_ENV=production

# AWS RDS PostgreSQL
DB_NAME=direction
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=your-rds.xxxxxxxxxx.region.rds.amazonaws.com
DB_PORT=5432
DB_SSL=true

# Hosts — comma-separated (API hostname(s); avoid committing real IPs in public docs)
ALLOWED_HOSTS=api.outcave.in

# Set USE_HTTPS=true when backend has SSL (e.g. api.outcave.in)
USE_HTTPS=true

# Optional HSTS (only when USE_HTTPS=true): defaults are 31536000s + include subdomains.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true  # only after submitting domain to browser HSTS preload list

# CORS — frontend origins that can call the API (Vercel, custom domain)
# outcave.in is also allowed via CORS_ALLOWED_ORIGIN_REGEXES
CORS_ALLOWED_ORIGINS=https://www.outcave.in,https://outcave.in,https://your-app.vercel.app

# CSRF — same as ALLOWED_HOSTS but with https:// prefix
CSRF_TRUSTED_ORIGINS=https://api.outcave.in,https://www.outcave.in,https://outcave.in

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your-secret
# Report price: set in config/pricing.py (REPORT_PRICE_INR)

# Google OAuth — add AWS API domain to Google Console authorized origins
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Rate limiting — shared Redis strongly recommended in production (all workers share counters).
# Example: redis://:password@your-elasticache.amazonaws.com:6379/0
# REDIS_URL=
# Trust X-Forwarded-For from one reverse proxy (e.g. AWS ALB). Local/dev: omit or DRF_NUM_PROXIES=0.
# DRF_NUM_PROXIES=1
# Optional per-scope overrides (examples): THROTTLE_AUTH_LOGIN=15/min THROTTLE_REPORT_PDF=20/hour
