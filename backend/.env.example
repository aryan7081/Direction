# Django
SECRET_KEY=your-secret-key-here
DJANGO_ENV=development

# Database — PostgreSQL required (same engine as production)
DB_NAME=career_discovery
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# DB_SSL=true   # enable if your dev DB requires TLS (e.g. some cloud instances)

# Razorpay (leave empty for dev mode — reports unlock for free)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (optional in dev). Required in production if using Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Sentry (optional): pip install sentry-sdk; set DSN to enable
# SENTRY_DSN=

# Report price (INR): edit config/pricing.py (not env)

# Google OAuth (for Sign in with Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============ PRODUCTION (AWS) - set DJANGO_ENV=production ============
# ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com
# DB_NAME=direction
# DB_USER=postgres
# DB_PASSWORD=your-secure-password
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_PORT=5432
# DB_SSL=true